DATA_GOV_API_KEY=your-data-gov-in-key
FIRMS_MAP_KEY=your-nasa-firms-map-key

# Optional
CPCB_TARGETS=Delhi,Delhi;Haryana,Gurugram;Punjab,Ludhiana;Maharashtra,Mumbai
FIRMS_SOURCE=VIIRS_SNPP_NRT
HCHO_HOTSPOT_THRESHOLD=20

ALLOW_DEMO_FALLBACK=true
CPCB_FETCH_SCOPE=india
AQI_GRID_STEP=1.25
AQI_GRID_MAX_POINTS=420

# CDS (Copernicus Climate Data Store) — just the UUID, no uid: prefix needed
CDS_API_KEY=your-cds-api-key

# Google Earth Engine project (for TROPOMI HCHO)
GEE_PROJECT=your-gee-project-id

# MOSDAC (INSAT-3D AOD) — add after account is approved
MOSDAC_USER=your-username
MOSDAC_PASS=your-password